SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Painel administrativo (/admin) — senha única compartilhada pelo time.
# ADMIN_PASSWORD: use uma senha longa e aleatória (não uma palavra do
# dicionário) — o rate-limit de tentativas de login (lib/server/rateLimit.ts)
# é só em memória do processo, então em deploy serverless (Vercel) não vale
# globalmente entre instâncias/cold starts. A senha em si é o freio real.
# ADMIN_SESSION_SECRET assina o cookie de sessão (HMAC) — gere um valor
# aleatório longo, nunca reaproveite entre ambientes.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
