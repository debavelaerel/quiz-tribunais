SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Painel administrativo (/admin) — senha única compartilhada pelo time.
# ADMIN_PASSWORD: use uma senha longa e aleatória (não uma palavra do
# dicionário) — o rate-limit de tentativas de login (lib/server/rateLimit.ts)
# é só em memória do processo, então em deploy serverless (Vercel) não vale
# globalmente entre instâncias/cold starts. A senha em si é o freio real.
# ADMIN_SESSION_SECRET assina o cookie de sessão (HMAC) — gere um valor
# aleatório longo, nunca reaproveite entre ambientes.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Serviço de geração do diagnóstico em PDF (services/diagnostico-pdf) — URL onde ele está
# rodando + segredo compartilhado (cabeçalho X-Laudo-Secret) que autentica
# esse app nele. Sem as duas, a geração de diagnóstico recusa antes de qualquer
# chamada de rede (ver lib/server/diagnosticoService.ts).
LAUDO_SERVICE_URL=
LAUDO_SERVICE_SECRET=

# Upload do diagnóstico/apresentação em PDF pro S3 (lib/server/s3.ts e
# services/diagnostico-pdf/s3.py) — feature opcional: sem as 4 vars configuradas,
# o upload é pulado sem erro (ainda não é bloqueante). Nomes de var próprios
# (não os padrão do SDK AWS_ACCESS_KEY_ID/AWS_REGION/etc) de propósito: a
# Vercel injeta suas PRÓPRIAS env vars AWS_* em toda function (identidade da
# execução dela, sem permissão nenhuma no nosso bucket) — usar nomes padrão
# faria o SDK cair silenciosamente nessa credencial errada se alguém
# esquecesse de configurar uma destas. ACCESS_KEY/SECRET_KEY aqui só valem
# enquanto o serviço roda fora de infra AWS própria (Vercel); se um dia
# migrar pra infra AWS de verdade (EC2/ECS/EKS/Lambda), o SDK deve passar a
# resolver a credencial sozinho via IAM role/IRSA, com estas duas viram
# fallback opcional só pra ambiente local.
BUCKET_NAME=
REGION=
ACCESS_KEY=
SECRET_KEY=
